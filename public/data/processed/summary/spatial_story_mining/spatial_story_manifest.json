    },
    "2": {
      "name": "coherent_june_activation",
      "description": "June NDVI and ET slopes are positive and ESI is nonnegative."
    },
    "3": {
      "name": "strong_june_activation",
      "description": "June NDVI and ET slopes are both in the upper activation range."
    },
    "4": {
      "name": "esi_watch_zone_exploratory",
      "description": "June NDVI and ET are positive but ESI slope is negative. Exploratory only."
    },
    "5": {
      "name": "demand_efficiency_watch_exploratory",
      "description": "June NDVI and ET are positive, PET is positive, and WUE is negative. Exploratory PET/WUE support watch zone."
    },
    "6": {
      "name": "efficient_activation_support",
      "description": "June NDVI and ET are positive and WUE is nonnegative where WUE raster support exists."
    },
    "7": {
      "name": "product_disagreement_zone",
      "description": "Main products point in conflicting directions."
    },
    "8": {
      "name": "high_variability_zone",
      "description": "One or more main products show high interannual variability."
    },
    "9": {
      "name": "seasonal_activation_zone",
      "description": "Winter-to-spring activation is consistently positive for NDVI and ET."
    },
    "10": {
      "name": "low_support_zone",
      "description": "Too few valid years or weak support for spatial interpretation."
    }
